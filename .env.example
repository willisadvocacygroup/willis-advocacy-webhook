# Willis Advocacy Group — Webhook Server Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control

# ── GoHighLevel ──────────────────────────────────────────
GHL_API_KEY=your_ghl_private_integration_token_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_WEBHOOK_URL=

# ── TrustedForm ──────────────────────────────────────────
# Get from: app.trustedform.com → Account → API Key
TRUSTEDFORM_API_KEY=your_trustedform_api_key_here

# ── Synthflow AI ─────────────────────────────────────────
# Get from: synthflow.ai → Settings → Webhooks
SYNTHFLOW_API_KEY=your_synthflow_api_key_here
SYNTHFLOW_AGENT_ID=your_synthflow_agent_id_here
# Optional: a secret string to verify Synthflow webhook calls
SYNTHFLOW_WEBHOOK_SECRET=your_synthflow_webhook_secret_here

# ── Email Alerts (new lead notifications) ────────────────
# Recommended: Gmail with an App Password (NOT your login password)
# How to set up: myaccount.google.com → Security → App Passwords → Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password_no_spaces
EMAIL_FROM=Willis Advocacy Group <your_gmail_address@gmail.com>
EMAIL_TO=info@willisadvocacygroup.com

# ── ManyChat ─────────────────────────────────────────────
# Optional token for verifying ManyChat webhook calls
MANYCHAT_VERIFY_TOKEN=your_manychat_verify_token_here

# ── Analytics (already hardcoded in HTML — reference only) ─
GA4_MEASUREMENT_ID=G-03QLEMVLW4
META_PIXEL_ID=614379199982364

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Admin ────────────────────────────────────────────────
# Protects /api/leads/recent endpoint (used by local dashboard)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=change_this_to_a_strong_random_secret
