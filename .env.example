# Copy this file to .env and fill in your real values
# Never commit .env to version control

# ── GoHighLevel ──────────────────────────────────────────
# Get from: GHL → Settings → Integrations → Webhooks
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/YOUR_WEBHOOK_ID/webhook-trigger/YOUR_TRIGGER_ID

# Get from: GHL → Settings → Integrations → API Keys
GHL_API_KEY=your_ghl_api_key_here

# Get from: GHL → Settings → Business Profile
GHL_LOCATION_ID=your_ghl_location_id_here

# ── TrustedForm ──────────────────────────────────────────
# Get from: app.trustedform.com after account creation
TRUSTEDFORM_API_KEY=your_trustedform_api_key_here

# ── Synthflow AI (activate after TCPA confirmation) ──────
# Get from: synthflow.ai dashboard after account setup
SYNTHFLOW_API_KEY=your_synthflow_api_key_here
SYNTHFLOW_AGENT_ID=your_agent_id_here

# ── Analytics ────────────────────────────────────────────
# Get from: analytics.google.com → Admin → Data Streams
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Get from: business.facebook.com → Events Manager
META_PIXEL_ID=your_pixel_id_here

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Admin ────────────────────────────────────────────────
# A secret key to protect the /api/leads/recent endpoint
# Generate a strong random string: openssl rand -hex 32
ADMIN_KEY=change_this_to_a_strong_random_secret
